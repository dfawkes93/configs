#!/usr/bin/env bash
# Claude Code status line: say which project this pane belongs to.
#
# Claude Code pipes session JSON in on stdin and prints whatever comes back at
# the bottom of the interface. With several sessions open across tmux projects
# the useful thing is identity — tmux session, directory, branch — with context
# usage on the end so a session that is filling up is obvious before it
# compacts.

set -uo pipefail

payload=$(cat)

# Feed the 5 h / weekly usage to the e-ink bridge (no-op if it isn't installed).
eink_hook=$HOME/.local/share/claude-eink/eink_hook.py
[[ -f $eink_hook ]] && { printf '%s' "$payload" | python3 -I "$eink_hook" --statusline >/dev/null 2>&1 & } 2>/dev/null
model=$(jq -r '.model.display_name // "?"' <<<"$payload")
dir=$(jq -r '.workspace.current_dir // ""' <<<"$payload")
pct=$(jq -r '.context_window.used_percentage // 0' <<<"$payload" | cut -d. -f1)

project=$(basename "${dir:-$PWD}")
branch=$(git -C "${dir:-.}" rev-parse --abbrev-ref HEAD 2>/dev/null)

where=$project
if [[ -n ${TMUX_PANE:-} ]] && command -v tmux >/dev/null; then
  session=$(tmux display-message -p -t "$TMUX_PANE" '#S' 2>/dev/null)
  [[ -n $session && $session != "$project" ]] && where="$session/$project"
  [[ -n $session && $session == "$project" ]] && where=$session
fi

dim=$'\e[2m'; reset=$'\e[0m'; blue=$'\e[34m'; grey=$'\e[90m'

line="${blue}${where}${reset}"
[[ -n $branch ]] && line+=" ${grey}⎇ ${branch}${reset}"
line+=" ${dim}·${reset} ${model} ${dim}·${reset} ${pct}%"

printf '%s' "$line"
